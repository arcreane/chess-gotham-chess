class Piece:
    def __init__(self, couleur):
        self.couleur = couleur


class Fou(Piece):
    def __init__(self, couleur):
        super().__init__(couleur)
        self.symbole = 'F' if couleur == 'Blanc' else 'f'

    def obtenir_mouvements_possibles(self, position_actuelle, echiquier):
        mouvements = []
        ligne_actuelle, col_actuelle = position_actuelle

        directions = [(-1, -1), (-1, 1), (1, -1), (1, 1)]

        for dl, dc in directions:
            ligne = ligne_actuelle + dl
            col = col_actuelle + dc

            while 0 <= ligne < 8 and 0 <= col < 8:
                piece_sur_case = echiquier[ligne][col]

                if piece_sur_case is None:
                    mouvements.append((ligne, col))
                elif piece_sur_case.couleur != self.couleur:
                    mouvements.append((ligne, col))
                    break
                else:
                    break

                ligne += dl
                col += dc

        return mouvements


plateau = [[None for _ in range(8)] for _ in range(8)]

fou_blanc = Fou('Blanc')
plateau[4][4] = fou_blanc

plateau[2][6] = Piece('Blanc')
plateau[6][2] = Piece('Noir')

mouvements = fou_blanc.obtenir_mouvements_possibles((4, 4), plateau)

print("Position du Fou : (4, 4)")
print("Mouvements possibles (ligne, colonne) :")
for mouv in mouvements:
    print(f"- Case {mouv}")
