class Knight(Piece):
    def __str__(self):
        return "N"

    def isValidMove(self, newPosition, board):
        if newPosition is None:
            return False

        if self.position.column == newPosition.column and self.position.row == newPosition.row:
            return False

        if newPosition.column < 'a' or newPosition.column > 'h':
            return False
        if newPosition.row < 1 or newPosition.row > 8:
            return False

        col_diff = abs(ord(newPosition.column) - ord(self.position.column))
        row_diff = abs(newPosition.row - self.position.row)

        if not ((col_diff == 2 and row_diff == 1) or (col_diff == 1 and row_diff == 2)):
            return False

        target_piece = board.getPiece(newPosition)
        if target_piece is not None and target_piece.color == self.color:
            return False

        return True
